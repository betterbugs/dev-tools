# Environment Configuration
# Copy this file to .env.local and fill in your values

# Environment: development | production
NEXT_ENV=development

# Verifiable OnGround Resolution System Configuration
# Replace with secure keys in production (use AWS KMS, Azure Key Vault, etc.)
SERVER_PRIVATE_KEY=dev-private-key-replace-in-production-with-secure-key
TOKEN_VALIDITY_MINUTES=15
GEO_FENCE_RADIUS_METERS=100

